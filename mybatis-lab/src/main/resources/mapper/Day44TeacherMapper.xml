<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="learning.persistence.Day44TeacherMapper">
    <!-- 列表和总数共用过滤片段，避免两个口径不一致。 -->
    <sql id="filters">
        <where>
            <if test="subject != null">subject = #{subject}</if>
        </where>
    </sql>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM teacher <include refid="filters"/>
    </select>
    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM teacher
    </select>
    <select id="page" resultMap="learning.persistence.Day41TeacherMapper.teacherMap">
        SELECT id, teacher_name, subject FROM teacher
        <include refid="filters"/>
        ORDER BY subject ASC, id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
