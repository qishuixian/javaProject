<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="learning.persistence.Day48BatchMapper">
    <select id="lessons" resultType="learning.persistence.LessonRow">
        SELECT id, teacher_id AS teacherId FROM lesson48 WHERE id &lt;= #{maxId} ORDER BY id
    </select>
    <select id="teacher" resultMap="learning.persistence.Day41TeacherMapper.teacherMap">
        SELECT id, teacher_name, subject FROM teacher WHERE id = #{id}
    </select>
    <select id="teachers" resultMap="learning.persistence.Day41TeacherMapper.teacherMap">
        SELECT id, teacher_name, subject FROM teacher
        <choose>
            <when test="ids != null and ids.size() > 0">
                WHERE id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
            </when>
            <otherwise>WHERE 1 = 0</otherwise>
        </choose>
    </select>
</mapper>
